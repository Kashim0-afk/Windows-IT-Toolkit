<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="01 - Driver Updater"
        Width="1080" Height="680"
        WindowStartupLocation="CenterScreen"
        MinWidth="891" MinHeight="444">
    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel>
                <TextBlock Text="Driver Updater" Style="{StaticResource HeaderTitle}"/>
                <TextBlock x:Name="lblSubtitle" Style="{StaticResource HeaderSubtitle}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="20,12,20,0" x:Name="brdAdminBanner">
            <TextBlock x:Name="lblAdminWarn" Style="{StaticResource AdminBannerText}"/>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="20,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnScan"        Content="Scansiona device problematici" IsDefault="True" AutomationProperties.Name="Scansiona i dispositivi con driver mancante o non funzionante"/>
                <Button x:Name="btnWinget"      Content="Cerca aggiornamenti (winget)" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="btnWingetAll"   Content="Aggiorna tutto (winget)" Style="{StaticResource SecondaryButton}"/>
                <!-- Separatore: divide le azioni di analisi/aggiornamento (frequenti)
                     da quelle di apertura strumenti esterni (rare). Prima erano 7
                     pulsanti tutti dello stesso peso sulla stessa riga. -->
                <Separator Width="16" Background="Transparent"/>
                <Button x:Name="btnExport"      Content="Esporta CSV"                  Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="btnOEM"         Content="Apri tool OEM"                Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="btnWU"          Content="Windows Update"               Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="btnDevMgr"      Content="Gestione Dispositivi"         Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0"
                Padding="20,10">
            <DockPanel>
                <TextBlock x:Name="lblCounter" DockPanel.Dock="Right"
                           Foreground="{StaticResource TextSecondaryBrush}" Text=""/>
                <TextBlock x:Name="lblStatus" Text="Pronto. Premi 'Scansiona device problematici' per analizzare i dispositivi PnP, oppure 'Cerca aggiornamenti' per usare winget."/>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="20" Padding="0">
            <TabControl x:Name="tabs" Background="Transparent" BorderThickness="0">
                <TabItem Header="Device problematici (PnP)">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="14,10,14,8">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="chkPnpAll" Content="Mostra anche disabilitati / SoftwareComponent (debug)"
                                          VerticalAlignment="Center"/>
                                <TextBlock Margin="14,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Default: solo driver mancanti o rotti. Doppio click: copia Hardware ID."/>
                            </StackPanel>
                        </Border>
                        <Grid>
              <TextBlock x:Name="lblEmptyDevices" Visibility="Collapsed"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Margin="32" MaxWidth="620" TextAlignment="Center" TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}"/>
              <ListView x:Name="lvDevices" AutomationProperties.Name="Elenco dispositivi con driver mancante o non funzionante" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Stato"             Width="90"  DisplayMemberBinding="{Binding Status}"/>
                                    <GridViewColumn Header="Nome dispositivo"  Width="280" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Dettaglio"         Width="220" DisplayMemberBinding="{Binding Detail}"/>
                                    <GridViewColumn Header="Classe"            Width="120" DisplayMemberBinding="{Binding Class}"/>
                                    <GridViewColumn Header="Vendor"            Width="110" DisplayMemberBinding="{Binding Vendor}"/>
                                    <GridViewColumn Header="Hardware ID"       Width="300" DisplayMemberBinding="{Binding HardwareID}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
            </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Aggiornamenti disponibili (winget)">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="14,10,14,4">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="chkIncludeUnknown" Content="Includi versioni sconosciute (--include-unknown)"
                                          VerticalAlignment="Center"/>
                                <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Default OFF: evita falsi aggiornamenti su pacchetti con versione installata non rilevabile."/>
                            </StackPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Margin="14,4,14,4" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Doppio click su una riga: copia il comando 'winget upgrade &lt;Id&gt;' negli appunti."/>
                        <Grid>
              <TextBlock x:Name="lblEmptyUpgrades" Visibility="Collapsed"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Margin="32" MaxWidth="620" TextAlignment="Center" TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}"/>
              <ListView x:Name="lvUpgrades" AutomationProperties.Name="Elenco aggiornamenti software disponibili" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nome"        Width="280" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Id"          Width="240" DisplayMemberBinding="{Binding Id}"/>
                                    <GridViewColumn Header="Versione"    Width="110" DisplayMemberBinding="{Binding Current}"/>
                                    <GridViewColumn Header="Disponibile" Width="110" DisplayMemberBinding="{Binding Available}"/>
                                    <GridViewColumn Header="Sorgente"    Width="90"  DisplayMemberBinding="{Binding Source}"/>
                                    <GridViewColumn Header="Note"        Width="200" DisplayMemberBinding="{Binding Note}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
            </Grid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Border>

    </DockPanel>
</Window>
