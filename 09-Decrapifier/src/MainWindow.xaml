<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="09 - Decrapifier"
        Width="1200" Height="720"
        WindowStartupLocation="CenterScreen"
        MinWidth="891" MinHeight="444">
    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel>
                <TextBlock Text="Decrapifier" Style="{StaticResource HeaderTitle}"/>
                <TextBlock Style="{StaticResource HeaderSubtitle}" Margin="0,2,0,0"
                           Text="Rimozione bloatware Win11 da whitelist curata. Anteprima sempre, applicazione con admin + backup."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="20,12,20,0" x:Name="brdAdminBanner">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="btnElevate" Content="Riavvia come amministratore"
                        Style="{StaticResource SecondaryButton}" Visibility="Collapsed" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblAdminWarn" Style="{StaticResource AdminBannerText}"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="20,12">
            <DockPanel>
              <TextBlock x:Name="lblCounter" DockPanel.Dock="Right" VerticalAlignment="Center"
                         Margin="12,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Profilo:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cboProfile" Width="280" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="btnPreview" Content="Anteprima" IsDefault="True"
                        AutomationProperties.Name="Anteprima delle app che verranno rimosse"/>
                <!-- DangerButton: rimozione permanente di app. Non deve avere lo stesso
                     peso visivo di 'Apri cartella profili'. -->
                <Button x:Name="btnApply"   Content="Applica (richiede admin)" Style="{StaticResource DangerButton}"
                        AutomationProperties.Name="Applica: rimuove le app elencate"/>
                <Button x:Name="btnCancel"  Content="Annulla" Style="{StaticResource SecondaryButton}" IsEnabled="False"
                        AutomationProperties.Name="Interrompi l'operazione in corso"/>
                <Button x:Name="btnRestore" Content="Ripristina ultimo backup" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="btnOpenProfiles" Content="Apri cartella profili" Style="{StaticResource SecondaryButton}"/>
              </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0"
                Padding="20,10">
            <TextBlock x:Name="lblStatus" Text="Pronto.  1) Scegli il profilo   2) Premi 'Anteprima' per vedere cosa verrebbe rimosso   3) 'Applica' per eseguire (reversibile con 'Ripristina')."/>
        </Border>

        <Border Style="{StaticResource Card}" Margin="20" Padding="0">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="App da rimuovere">
                  <DockPanel>
                    <!-- Le app bloccate dalla blacklist di sicurezza erano segnalate
                         solo in coda alla status bar: qui sono visibili accanto alla
                         lista che stanno integrando. -->
                    <Border x:Name="brdBlocked" DockPanel.Dock="Top" Visibility="Collapsed"
                            Style="{StaticResource AdminBannerWarn}" Margin="8,8,8,0">
                        <TextBlock x:Name="lblBlocked" Style="{StaticResource AdminBannerText}"/>
                    </Border>
                    <TextBlock x:Name="lblAppxEmpty" DockPanel.Dock="Top" Visibility="Collapsed"
                               Margin="16" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Nessuna app da rimuovere per questo profilo: sono già tutte assenti da questo PC."/>
                    <ListView x:Name="lvAppx" AutomationProperties.Name="Elenco app che verranno rimosse" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nome"      Width="280" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Versione"  Width="120" DisplayMemberBinding="{Binding Version}"/>
                                <GridViewColumn Header="Publisher" Width="280" DisplayMemberBinding="{Binding Publisher}"/>
                                <GridViewColumn Header="FullName"  Width="360" DisplayMemberBinding="{Binding FullName}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                  </DockPanel>
                </TabItem>
                <TabItem Header="Non installate">
                    <Grid>
              <TextBlock x:Name="lblEmptyNotInstalled" Visibility="Collapsed"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Margin="32" MaxWidth="620" TextAlignment="Center" TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}"/>
              <ListView x:Name="lvNotInstalled" AutomationProperties.Name="Elenco app gia assenti da questo PC" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nome (già assente)" Width="500" DisplayMemberBinding="{Binding}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
            </Grid>
                </TabItem>
                <TabItem Header="Log operazioni">
                    <TextBox x:Name="txtLog" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="14"/>
                </TabItem>
            </TabControl>
        </Border>

    </DockPanel>
</Window>
