<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="10 - GDPR Scanner"
        Width="1200" Height="720"
        WindowStartupLocation="CenterScreen"
        MinWidth="891" MinHeight="444">
    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel>
                <TextBlock Text="GDPR Scanner" Style="{StaticResource HeaderTitle}"/>
                <TextBlock Style="{StaticResource HeaderSubtitle}" Margin="0,2,0,0"
                           Text="Scansione dati personali italiani con validazione checksum. Read-only."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="20,12,20,0" x:Name="brdAdminBanner">
            <TextBlock x:Name="lblAdminWarn" Style="{StaticResource AdminBannerText}"/>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Cartella:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox  Grid.Column="1" x:Name="txtPath"/>
                <Button   Grid.Column="2" x:Name="btnBrowse" Content="Sfoglia..." Style="{StaticResource SecondaryButton}"/>
                <Button   Grid.Column="3" x:Name="btnScan"   Content="Avvia scansione" IsDefault="True" AutomationProperties.Name="Avvia la scansione della cartella"/>
                <Button   Grid.Column="4" x:Name="btnStop"   Content="Annulla" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="20,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tipi:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <CheckBox x:Name="chkCF"    Content="Codice Fiscale" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox x:Name="chkPIVA"  Content="Partita IVA"   IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox x:Name="chkIBAN"  Content="IBAN"          IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox x:Name="chkCARTA" Content="Carta credito" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox x:Name="chkEMAIL" Content="Email"         IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Separator Width="20" Background="Transparent"/>
                <Button x:Name="btnExportHtml" Content="Esporta HTML" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="btnExportCsv"  Content="Esporta CSV"  Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0"
                Padding="20,8">
            <DockPanel>
                <TextBlock x:Name="lblCounter" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Text=""/>
                <ProgressBar AutomationProperties.Name="Avanzamento operazione" x:Name="prgScan" Height="6" Minimum="0" Maximum="100" Value="0"
                             Background="#FFE5E5E5" Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0"
                Padding="20,8">
            <TextBlock x:Name="lblStatus" Text="Pronto.  1) Scegli la cartella da analizzare   2) Seleziona i tipi di dato   3) Premi 'Avvia scansione'."/>
        </Border>

        <Border Style="{StaticResource Card}" Margin="20" Padding="0">
            <Grid>
              <TextBlock x:Name="lblEmptyHits" Visibility="Collapsed"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Margin="32" MaxWidth="620" TextAlignment="Center" TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}"/>
              <ListView x:Name="lvHits" AutomationProperties.Name="Elenco file contenenti dati personali" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="File"           Width="380" DisplayMemberBinding="{Binding File}"/>
                        <GridViewColumn Header="Ext"            Width="60"  DisplayMemberBinding="{Binding Extension}"/>
                        <GridViewColumn Header="KB"             Width="60"  DisplayMemberBinding="{Binding SizeKB}"/>
                        <GridViewColumn Header="CF"             Width="50"  DisplayMemberBinding="{Binding CF}"/>
                        <GridViewColumn Header="PIVA"           Width="50"  DisplayMemberBinding="{Binding PIVA}"/>
                        <GridViewColumn Header="IBAN"           Width="50"  DisplayMemberBinding="{Binding IBAN}"/>
                        <GridViewColumn Header="Carta"          Width="50"  DisplayMemberBinding="{Binding CARTA}"/>
                        <GridViewColumn Header="Email"          Width="60"  DisplayMemberBinding="{Binding EMAIL}"/>
                        <GridViewColumn Header="Tot"            Width="50"  DisplayMemberBinding="{Binding Total}"/>
                        <GridViewColumn Header="Esempi (mascherati)" Width="280" DisplayMemberBinding="{Binding ExamplesMasked}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            </Grid>
        </Border>

    </DockPanel>
</Window>
