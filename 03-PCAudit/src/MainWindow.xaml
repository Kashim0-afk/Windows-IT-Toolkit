<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="03 - PC Audit"
        Width="1200" Height="720"
        WindowStartupLocation="CenterScreen"
        MinWidth="891" MinHeight="444">
    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel>
                <TextBlock Text="PC Audit" Style="{StaticResource HeaderTitle}"/>
                <TextBlock x:Name="lblSubtitle" Style="{StaticResource HeaderSubtitle}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="20,12,20,0" x:Name="brdAdminBanner">
            <TextBlock x:Name="lblAdminWarn" Style="{StaticResource AdminBannerText}"/>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="20,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnAudit"      Content="Esegui audit" IsDefault="True" AutomationProperties.Name="Esegui l'audit completo del PC"/>
                <Button x:Name="btnExportHtml" Content="Esporta HTML"      Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="btnOpenReport" Content="Apri ultimo report" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="btnOpenFolder" Content="Apri cartella report" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="btnElevate"    Content="Riavvia come amministratore" Style="{StaticResource SecondaryButton}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0"
                Padding="20,8">
            <DockPanel>
                <TextBlock x:Name="lblCounter" DockPanel.Dock="Right"
                           Foreground="{StaticResource TextSecondaryBrush}" Text=""/>
                <ProgressBar AutomationProperties.Name="Avanzamento operazione" x:Name="prgScan" Height="6" Minimum="0" Maximum="100" Value="0"
                             Background="#FFE5E5E5" Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0"
                Padding="20,8">
            <TextBlock x:Name="lblStatus" Text="Pronto. Premi 'Esegui audit' per analizzare il PC (read-only)."/>
        </Border>

        <Border Style="{StaticResource Card}" Margin="20" Padding="0">
            <TabControl x:Name="tabs" Background="Transparent" BorderThickness="0">
                <TabItem Header="Hardware">
                    <TextBox x:Name="txtHW" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0" Padding="14"/>
                </TabItem>
                <TabItem Header="Sistema">
                    <TextBox x:Name="txtOS" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0" Padding="14"/>
                </TabItem>
                <TabItem Header="Sicurezza">
                    <TextBox x:Name="txtSec" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0" Padding="14"/>
                </TabItem>
                <TabItem Header="Rete">
                    <TextBox x:Name="txtNet" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0" Padding="14"/>
                </TabItem>
                <TabItem Header="Utenti">
                    <TextBox x:Name="txtUsr" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0" Padding="14"/>
                </TabItem>
                <TabItem Header="Software">
                    <TextBox x:Name="txtSw" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0" Padding="14"/>
                </TabItem>
            </TabControl>
        </Border>

    </DockPanel>
</Window>
